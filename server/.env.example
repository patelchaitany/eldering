# Copy to .env (chmod 600). Generate every secret with: openssl rand -hex 32
# On the server, deploy/deploy.sh generates these in place and never prints them.
# Hex keeps the values URL-safe inside the DSNs built by docker-compose.yml.

POSTGRES_PASSWORD=
ELDERING_OWNER_PASSWORD=
ELDERING_APP_PASSWORD=
# HS256 key for access tokens, hex, at least 32 bytes (64 hex chars).
JWT_SECRET=

# Image tag of eldering-api to run (deploy.sh sets this).
API_TAG=dev

# Base URL used to build incident share links.
PUBLIC_BASE_URL=https://safety.example.com

# Optional tuning (defaults shown; read by the API process):
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL=720h
# SHARE_TOKEN_TTL=72h
# INVITE_TTL=48h
# INVITE_MAX_USES=10
# RETENTION_INTERVAL=1h
# BODY_LIMIT_BYTES=1048576
# MAX_PASSWORD_HASH_JOBS=2
# RATE_AUTH_PER_MIN=10        RATE_AUTH_BURST=10
# RATE_TOKEN_PER_MIN=60       RATE_TOKEN_BURST=30
# RATE_LOGIN_ACCOUNT_PER_MIN=1 RATE_LOGIN_ACCOUNT_BURST=5
# RATE_SHARE_PER_MIN=60       RATE_SHARE_BURST=30
# LOG_LEVEL=info
